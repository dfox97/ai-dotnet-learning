{
  "name": "dotnet-review-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "node --test tests/*.test.ts",
    "validate:content": "node scripts/validate-content.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "lucide-react": "1.37.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shiki": "4.4.3",
    "vite": "8.2.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.69.0"
  }
}
